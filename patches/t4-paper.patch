diff --git a/simulation/prepare_t4_t50_benchmark.py b/simulation/prepare_t4_t50_benchmark.py
new file mode 100644
index 0000000..5fd37ea
--- /dev/null
+++ b/simulation/prepare_t4_t50_benchmark.py
@@ -0,0 +1,204 @@
+"""Adapt a leakage-free temporal benchmark to the native T4 pickle contract."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import pickle
+from collections import Counter
+from pathlib import Path
+
+import numpy as np
+
+
+TEMPORAL_FEATURES = tuple(f"x_{index:02d}" for index in range(20))
+T4_STATIC_FEATURES = tuple(f"static_{index:02d}" for index in range(5))
+EXPECTED_TIMESTAMPS = 50
+EXPECTED_SPLITS = {"train": 3500, "validation": 750, "test": 750}
+
+
+def _load_json(path: Path) -> dict:
+    with path.open(encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+def prepare(
+    source_pickle: Path,
+    source_dataset: Path,
+    source_truth: Path,
+    output_dir: Path,
+    dataset_name: str,
+) -> dict[str, object]:
+    with source_pickle.open("rb") as handle:
+        raw = pickle.load(handle)
+    dataset_payload = _load_json(source_dataset)
+    truth_payload = _load_json(source_truth)
+
+    patients = dataset_payload.get("patients", [])
+    truth_patients = truth_payload.get("patients", [])
+    raw_rows = list(raw.values())
+    if not (len(raw_rows) == len(patients) == len(truth_patients) == 5000):
+        raise ValueError(
+            "Expected 5,000 aligned patients in the pickle, dataset, and truth files"
+        )
+
+    truth_by_id = {str(row["patient_id"]): row for row in truth_patients}
+    if len(truth_by_id) != len(truth_patients):
+        raise ValueError("Oracle truth contains duplicate patient IDs")
+
+    converted: dict[str, dict[str, object]] = {}
+    split_rows: list[dict[str, str]] = []
+    converted_truth: list[dict[str, object]] = []
+    split_counts: Counter[str] = Counter()
+
+    for position, (source, patient) in enumerate(zip(raw_rows, patients), start=1):
+        patient_id = str(patient["patient_id"])
+        expected_id = f"SYNTHETIC_{position:06d}"
+        if patient_id != expected_id:
+            raise ValueError(
+                f"Patient order mismatch at row {position}: {patient_id!r} != {expected_id!r}"
+            )
+
+        split = str(patient.get("split", ""))
+        if split not in EXPECTED_SPLITS:
+            raise ValueError(f"Invalid or missing split for {patient_id}: {split!r}")
+        split_counts[split] += 1
+
+        x = np.asarray(source["x"], dtype=np.float32)
+        x_static = np.asarray(source["x_static"], dtype=np.float32)
+        treatment = np.asarray(source["a"], dtype=np.int64)
+        outcomes = np.asarray(source["y"], dtype=np.float32)
+        if x.shape != (len(TEMPORAL_FEATURES), EXPECTED_TIMESTAMPS):
+            raise ValueError(f"Unexpected temporal shape for {patient_id}: {x.shape}")
+        if x_static.shape != (5,):
+            raise ValueError(f"Unexpected static shape for {patient_id}: {x_static.shape}")
+        if treatment.shape != (EXPECTED_TIMESTAMPS,):
+            raise ValueError(f"Unexpected treatment shape for {patient_id}: {treatment.shape}")
+        if outcomes.shape != (2, EXPECTED_TIMESTAMPS):
+            raise ValueError(f"Unexpected outcome shape for {patient_id}: {outcomes.shape}")
+        if not np.isin(treatment, (0, 1)).all():
+            raise ValueError(f"Treatment must be binary for {patient_id}")
+
+        training_row: dict[str, object] = {
+            name: x[index].tolist()
+            for index, name in enumerate(TEMPORAL_FEATURES)
+        }
+        training_row.update(
+            {
+                name: float(x_static[index])
+                for index, name in enumerate(T4_STATIC_FEATURES)
+            }
+        )
+        training_row.update(
+            {
+                "treatment": treatment.tolist(),
+                # The raw pickle stores factual outcomes in row zero. Oracle
+                # potential outcomes remain exclusively in the truth artifact.
+                "outcome": outcomes[0].tolist(),
+                # T4 requires this legacy field, but causal training does not use it.
+                "death": 0,
+            }
+        )
+        converted[patient_id] = training_row
+        split_rows.append({"source_patient_id": patient_id, "split": split})
+
+        oracle = truth_by_id.get(patient_id)
+        if oracle is None or str(oracle.get("split")) != split:
+            raise ValueError(f"Truth/split mismatch for {patient_id}")
+        counterfactual = oracle.get("counterfactual_truth", [])
+        if len(counterfactual) != EXPECTED_TIMESTAMPS:
+            raise ValueError(f"Unexpected oracle horizon for {patient_id}")
+        converted_truth.append(
+            {
+                "source_patient_id": patient_id,
+                "y0": [float(row["y0"]) for row in counterfactual],
+                "y1": [float(row["y1"]) for row in counterfactual],
+                "ite": [float(row["ite"]) for row in counterfactual],
+            }
+        )
+
+    if dict(split_counts) != EXPECTED_SPLITS:
+        raise ValueError(
+            f"Unexpected split counts: {dict(split_counts)} != {EXPECTED_SPLITS}"
+        )
+
+    output_dir.mkdir(parents=True, exist_ok=True)
+    dataset_path = output_dir / f"{dataset_name}.pkl"
+    header_path = output_dir / "header.pkl"
+    split_path = output_dir / "split_manifest.json"
+    truth_path = output_dir / "oracle_truth.json"
+    metadata_path = output_dir / "preparation_metadata.json"
+
+    with dataset_path.open("wb") as handle:
+        pickle.dump(converted, handle, protocol=pickle.HIGHEST_PROTOCOL)
+    with header_path.open("wb") as handle:
+        pickle.dump(list(TEMPORAL_FEATURES), handle, protocol=pickle.HIGHEST_PROTOCOL)
+    split_path.write_text(
+        json.dumps(
+            {
+                "metadata": {
+                    "n_patients": len(converted),
+                    "split_counts": EXPECTED_SPLITS,
+                    "source_dataset": str(source_dataset.resolve()),
+                },
+                "patients": split_rows,
+            },
+            indent=2,
+        )
+        + "\n",
+        encoding="utf-8",
+    )
+    truth_path.write_text(
+        json.dumps(
+            {
+                "metadata": {
+                    "n_patients": len(converted),
+                    "sequence_length": EXPECTED_TIMESTAMPS,
+                    "training_dataset_contains_truth": False,
+                    "source_truth": str(source_truth.resolve()),
+                },
+                "patients": converted_truth,
+            },
+            indent=2,
+        )
+        + "\n",
+        encoding="utf-8",
+    )
+    metadata = {
+        "dataset": str(dataset_path.resolve()),
+        "header": str(header_path.resolve()),
+        "split_manifest": str(split_path.resolve()),
+        "oracle_truth": str(truth_path.resolve()),
+        "patients": len(converted),
+        "timesteps": EXPECTED_TIMESTAMPS,
+        "temporal_features": len(TEMPORAL_FEATURES),
+        "source_static_features": 5,
+        "t4_static_features": 5,
+        "static_features": list(T4_STATIC_FEATURES),
+        "split_counts": dict(split_counts),
+        "oracle_truth_used_for_training": False,
+    }
+    metadata_path.write_text(json.dumps(metadata, indent=2) + "\n", encoding="utf-8")
+    return metadata
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-pickle", type=Path, required=True)
+    parser.add_argument("--source-dataset", type=Path, required=True)
+    parser.add_argument("--source-truth", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--dataset-name", default="t4_t50_n5000_seed2027")
+    return parser.parse_args()
+
+
+if __name__ == "__main__":
+    arguments = parse_args()
+    result = prepare(
+        arguments.source_pickle,
+        arguments.source_dataset,
+        arguments.source_truth,
+        arguments.output_dir,
+        arguments.dataset_name,
+    )
+    print(json.dumps(result, indent=2))
