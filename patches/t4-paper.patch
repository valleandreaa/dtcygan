+"""Evaluate a trained T4 checkpoint against external semi-synthetic truth."""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import logging
+import pickle
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+import torch
+from torch.utils.data import DataLoader
+
+
+MODEL_DIR = Path(__file__).resolve().parents[1] / "model"
+if str(MODEL_DIR) not in sys.path:
+    sys.path.insert(0, str(MODEL_DIR))
+
+from dataset import load_and_process_data, load_shared_split_subsets, pad_and_truncate  # noqa: E402
+
+
+def _correlation(left: np.ndarray, right: np.ndarray) -> float:
+    if np.std(left) == 0 or np.std(right) == 0:
+        return 0.0
+    return float(np.corrcoef(left.ravel(), right.ravel())[0, 1])
+
+
+def _metrics(truth: np.ndarray, prediction: np.ndarray) -> dict[str, float]:
+    error = prediction - truth
+    truth_std = float(np.std(truth))
+    pehe = float(np.sqrt(np.mean(np.square(error))))
+    return {
+        "pehe": pehe,
+        "normalized_pehe": pehe / truth_std if truth_std > 0 else 0.0,
+        "true_ate": float(np.mean(truth)),
+        "predicted_ate": float(np.mean(prediction)),
+        "ate_absolute_error": float(abs(np.mean(prediction) - np.mean(truth))),
+        "ite_correlation": _correlation(truth, prediction),
+        "effect_sign_accuracy": float(np.mean(np.sign(truth) == np.sign(prediction))),
+    }
+
+
+def run(args: argparse.Namespace) -> dict[str, object]:
+    data_path = Path(args.data_dir) / f"{args.dataset_name}.pkl"
+    with data_path.open("rb") as handle:
+        raw = pickle.load(handle)
+    raw_by_id = {str(patient_id): datum for patient_id, datum in raw.items()}
+    with Path(args.header).open("rb") as handle:
+        feature_names = pickle.load(handle)
+    truth_payload = json.loads(Path(args.truth).read_text())
+    truth_by_id = {
+        str(row["source_patient_id"]): row for row in truth_payload["patients"]
+    }
+    source_ids = [str(value) for value in raw]
+    if set(source_ids) != set(truth_by_id):
+        raise ValueError("T4 oracle truth IDs do not match the training pickle")
+
+    loader_args = SimpleNamespace(
+        data_dir=str(Path(args.data_dir)) + "/",
+        dataset_name=args.dataset_name,
+        header_path=args.header,
+        load_cache=False,
+        max_stay=args.max_stay,
+        pre_window=args.pre_window,
+        negative_sample=False,
+        static_features=args.static_features,
+    )
+    device = torch.device(args.device or ("cuda" if torch.cuda.is_available() else "cpu"))
+    _, dataset = load_and_process_data(
+        loader_args, device, logging.getLogger(__name__), args.dataset_name
+    )
+    subsets = load_shared_split_subsets(dataset, data_path, args.split_manifest)
+    subset_by_name = dict(zip(("train", "validation", "test"), subsets))
+    selected = subset_by_name[args.split]
+
+    padded_factual = []
+    for patient_id, datum in raw.items():
+        factual = np.asarray(datum["outcome"], dtype=float)
+        features = np.column_stack(
+            [np.asarray(datum[name], dtype=float) for name in feature_names]
+        )
+        _, _, _, y_pad, _ = pad_and_truncate(
+            patient_id,
+            features,
+            factual,
+            np.asarray(datum["treatment"], dtype=float),
+            args.max_stay,
+            args.pre_window,
+        )
+        padded_factual.append(y_pad)
+    padded_factual_array = np.asarray(padded_factual, dtype=float)
+    outcome_mean = padded_factual_array.mean(axis=0)[1:]
+    outcome_std = padded_factual_array.std(axis=0, ddof=1)[1:]
+    outcome_std = np.where(outcome_std > 0, outcome_std, 1.0)
+
+    model = torch.load(args.checkpoint, map_location=device, weights_only=False)
+    model = model.to(device)
+    model.device = device
+    model.encoder.device = device
+    model.eval()
+
+    predictions_y0 = []
+    predictions_y1 = []
+    factual_predictions = []
+    with torch.no_grad():
+        for x, x_demo, treatment, _, y, _, _ in DataLoader(
+            selected, batch_size=args.batch_size, shuffle=False
+        ):
+            output, output_cf, _, _, _ = model(
+                x, y, x_demo, treatment, teacher_forcing_ratio=0
+            )
+            assigned = treatment[:, args.max_stay : args.max_stay + args.pre_window]
+            pred_y1 = output * assigned + output_cf * (1 - assigned)
+            pred_y0 = output_cf * assigned + output * (1 - assigned)
+            predictions_y0.append(pred_y0.cpu().numpy())
+            predictions_y1.append(pred_y1.cpu().numpy())
+            factual_predictions.append(output.cpu().numpy())
+
+    pred_y0 = np.concatenate(predictions_y0) * outcome_std + outcome_mean
+    pred_y1 = np.concatenate(predictions_y1) * outcome_std + outcome_mean
+    pred_factual = np.concatenate(factual_predictions) * outcome_std + outcome_mean
+    selected_indices = list(selected.indices)
+    selected_ids = [source_ids[index] for index in selected_indices]
+    truth_y0 = np.asarray(
+        [truth_by_id[value]["y0"][-args.pre_window :] for value in selected_ids],
+        dtype=float,
+    )
+    truth_y1 = np.asarray(
+        [truth_by_id[value]["y1"][-args.pre_window :] for value in selected_ids],
+        dtype=float,
+    )
+    factual = np.asarray(
+        [raw_by_id[value]["outcome"][-args.pre_window :] for value in selected_ids],
+        dtype=float,
+    )
+    truth_ite = truth_y1 - truth_y0
+    predicted_ite = pred_y1 - pred_y0
+    report = {
+        "model": "T4",
+        "checkpoint": str(Path(args.checkpoint).resolve()),
+        "split": args.split,
+        "n_patients": len(selected_ids),
+        "timestamps": list(
+            range(
+                len(truth_by_id[selected_ids[0]]["y0"]) - args.pre_window,
+                len(truth_by_id[selected_ids[0]]["y0"]),
+            )
+        ),
+        "causal_effect": _metrics(truth_ite, predicted_ite),
+        "factual_outcome": {
+            "rmse": float(np.sqrt(np.mean(np.square(pred_factual - factual)))),
+            "mae": float(np.mean(np.abs(pred_factual - factual))),
+        },
+        "methodology": {
+            "counterfactual_truth_used_during_training": False,
+            "shared_split_manifest": str(Path(args.split_manifest).resolve()),
+            "estimand": "conditional point-treatment effect Y_t(1)-Y_t(0) at observed history",
+            "static_features": list(args.static_features),
+        },
+    }
+    rows = []
+    for offset, timestamp in enumerate(report["timestamps"]):
+        row = {"timestamp": timestamp, **_metrics(truth_ite[:, offset], predicted_ite[:, offset])}
+        rows.append(row)
+
+    destination = Path(args.output_dir)
+    destination.mkdir(parents=True, exist_ok=True)
+    (destination / "report.json").write_text(json.dumps(report, indent=2) + "\n")
+    with (destination / "metrics_by_timestep.csv").open("w", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=list(rows[0]))
+        writer.writeheader()
+        writer.writerows(rows)
+    causal = report["causal_effect"]
+    (destination / "summary.md").write_text(
+        f"# T4 semi-synthetic {report['split']} evaluation\n\n"
+        f"- Patients: {report['n_patients']}\n"
+        f"- PEHE: {causal['pehe']:.6f}\n"
+        f"- Normalized PEHE: {causal['normalized_pehe']:.6f}\n"
+        f"- ATE absolute error: {causal['ate_absolute_error']:.6f}\n"
+        f"- ITE correlation: {causal['ite_correlation']:.6f}\n"
+    )
+    return report
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--data-dir", required=True)
+    parser.add_argument("--dataset-name", required=True)
+    parser.add_argument("--header", required=True)
+    parser.add_argument(
+        "--static-features",
+        nargs="+",
+        default=["agegroup", "heightgroup", "weightgroup", "gender"],
+    )
+    parser.add_argument("--truth", required=True)
+    parser.add_argument("--split-manifest", required=True)
+    parser.add_argument("--checkpoint", required=True)
+    parser.add_argument("--output-dir", required=True)
+    parser.add_argument("--split", choices=("train", "validation", "test"), default="test")
+    parser.add_argument("--max-stay", type=int, default=16)
+    parser.add_argument("--pre-window", type=int, default=7)
+    parser.add_argument("--batch-size", type=int, default=128)
+    parser.add_argument("--device")
+    return parser.parse_args()
+
+
+if __name__ == "__main__":
+    result = run(parse_args())
+    print(json.dumps(result["causal_effect"], indent=2))
