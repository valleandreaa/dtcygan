+def load_shared_split_subsets(dataset, data_path, split_manifest_path):
+    """Return fixed train/validation/test subsets after identity validation."""
+    with open(data_path, 'rb') as handle:
+        source_ids = [str(value) for value in pickle.load(handle).keys()]
+    with open(split_manifest_path, encoding='utf-8') as handle:
+        manifest = json.load(handle)
+    patients = manifest.get('patients', [])
+    manifest_ids = [str(row['source_patient_id']) for row in patients]
+    if manifest_ids != source_ids:
+        raise ValueError('Split manifest patient order does not match the T4 training pickle')
+    if len(dataset) != len(source_ids):
+        raise ValueError('T4 tensor dataset dropped patients from the shared split manifest')
+    valid = {'train', 'validation', 'test'}
+    labels = [str(row['split']) for row in patients]
+    if set(labels) != valid:
+        raise ValueError('Shared split manifest must contain train, validation, and test')
+    indices = {
+        name: [index for index, label in enumerate(labels) if label == name]
+        for name in ('train', 'validation', 'test')
+    }
+    if any(not values for values in indices.values()):
+        raise ValueError('Every shared split must contain at least one patient')
+    return tuple(Subset(dataset, indices[name]) for name in ('train', 'validation', 'test'))
+
